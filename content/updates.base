filters:
  and:
    - file.ext == "md"
    - '!file.name.contains("index")'
    - '!file.name.contains("canvas")'
    - '!file.inFolder("assets")'
    - '!file.inFolder("backoffice")'
    - '!file.hasLink("Not Found")'
formulas:
  Untitled: file.mtime.format("YYYY-MM-DD HH:mm")
properties:
  formula.Untitled:
    displayName: published on
views:
  - type: cards
    name: cards
    order:
      - formula.Untitled
      - excerpt
    sort:
      - property: file.mtime
        direction: ASC
    limit: 12
    cardSize: 300
    image: note.cover
    imageAspectRatio: 2.2
  - type: table
    name: table
    sort:
      - property: created
        direction: DESC
    cardSize: 400
    image: note.cover
    imageAspectRatio: 0.5
  - type: list
    name: list
    order:
      - file.name
      - modified
    markers: none
    indentProperties: true
