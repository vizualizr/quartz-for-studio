filters:
  and:
    - file.folder != "assets"
    - file.folder != "backoffice"
    - file.name != "index"
    - file.ext == "md"
views:
  - type: cards
    name: card view
    order:
      - file.basename
      - file.folder
    sort:
      - property: file.mtime
        direction: DESC
    limit: 5
    cardSize: 380
    image: note.cover
    imageAspectRatio: 0.5
